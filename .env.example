# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─────────────────────────────────────────────
# META WHATSAPP BUSINESS API (Cloud API)
# All values come from your Meta App Dashboard.
# See SETUP.md Step 4 for full instructions.
# ─────────────────────────────────────────────

# Permanent System User Access Token
# (from Meta Business Suite → System Users → Generate Token)
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Phone Number ID — NOT the phone number itself
# (from Meta App → WhatsApp → API Setup → "Phone number ID")
WHATSAPP_PHONE_NUMBER_ID=1234567890123456

# WhatsApp Business Account ID
# (from Meta App → WhatsApp → API Setup → "WhatsApp Business Account ID")
WHATSAPP_BUSINESS_ACCOUNT_ID=9876543210987654

# Your custom webhook verify token — make up any secret string
# (you will paste this same string in Meta App → Webhooks → Verify Token)
WHATSAPP_VERIFY_TOKEN=zetta_farms_webhook_secret_2024

# ─────────────────────────────────────────────
# OPENAI
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# gpt-4-turbo-preview = best accuracy | gpt-3.5-turbo = lower cost
OPENAI_MODEL=gpt-4-turbo-preview

# ─────────────────────────────────────────────
# SUPABASE
# ─────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Use the SERVICE ROLE key — NOT the anon key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx

# ─────────────────────────────────────────────
# REDIS (session management for 600 concurrent farmers)
# Upstash format: redis://default:PASSWORD@HOST:PORT
# Railway Redis:  automatically injected as REDIS_URL
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# OPTIONAL TUNING
# ─────────────────────────────────────────────
SESSION_TTL_SECONDS=86400
MAX_CONVERSATION_TURNS=40
